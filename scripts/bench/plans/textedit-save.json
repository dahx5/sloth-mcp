{
 "steps": [
  {
   "action": "focus_app",
   "app_name": "TextEdit",
   "timeout_ms": 20000
  },
  {
   "action": "hotkey",
   "keys": [
    "cmd",
    "n"
   ],
   "expect": {
    "screen_changes": true
   },
   "timeout_ms": 10000
  },
  {
   "action": "hotkey",
   "keys": [
    "cmd",
    "shift",
    "t"
   ],
   "timeout_ms": 6000
  },
  {
   "action": "type",
   "text": "Report ready",
   "expect": {
    "appears": "Report ready"
   },
   "timeout_ms": 10000
  },
  {
   "action": "hotkey",
   "keys": [
    "cmd",
    "s"
   ],
   "expect": {
    "appears": "Save"
   },
   "timeout_ms": 10000
  },
  {
   "action": "hotkey",
   "keys": [
    "cmd",
    "shift",
    "g"
   ],
   "expect": {
    "screen_changes": true
   },
   "timeout_ms": 8000
  },
  {
   "action": "type",
   "text": "~/choto-bench-sandbox",
   "timeout_ms": 8000
  },
  {
   "action": "hotkey",
   "keys": [
    "enter"
   ],
   "expect": {
    "screen_changes": true
   },
   "timeout_ms": 8000
  },
  {
   "action": "hotkey",
   "keys": [
    "cmd",
    "a"
   ],
   "timeout_ms": 5000
  },
  {
   "action": "type",
   "text": "note.txt",
   "timeout_ms": 8000
  },
  {
   "action": "hotkey",
   "keys": [
    "enter"
   ],
   "expect": {
    "disappears": "Save"
   },
   "timeout_ms": 12000
  }
 ]
}