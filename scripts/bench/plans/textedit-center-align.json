   "timeout_ms": 10000
  },
  {
   "action": "click",
   "target": {
    "text": "Text",
    "scope": "chrome"
   },
   "expect": {
    "appears": "Center"
   },
   "timeout_ms": 10000
  },
  {
   "action": "click",
   "target": {
    "text": "Center",
    "scope": "chrome"
   },
   "expect": {
    "screen_changes": true
   },
   "timeout_ms": 10000
  },
  {
   "action": "hotkey",
   "keys": [
    "cmd",
    "s"
   ],
   "expect": {
    "screen_changes": true
   },
   "timeout_ms": 12000
