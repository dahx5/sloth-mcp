{
 "steps": [
  {
   "action": "focus_app",
   "app_name": "TextEdit",
   "timeout_ms": 20000
  },
  {
   "action": "hotkey",
   "keys": [
    "cmd",
    "o"
   ],
   "expect": {
    "screen_changes": true
   },
   "timeout_ms": 10000
  },
  {
   "action": "hotkey",
   "keys": [
    "cmd",
    "shift",
    "g"
   ],
   "expect": {
    "screen_changes": true
   },
   "timeout_ms": 8000
  },
  {
   "action": "type",
   "text": "~/choto-bench-sandbox/styled.rtf",
   "timeout_ms": 8000
  },
  {
   "action": "hotkey",
   "keys": [
    "enter"
   ],
   "timeout_ms": 8000
  },
  {
   "action": "hotkey",
   "keys": [
    "enter"
   ],
   "expect": {
    "appears": "Quarterly summary"
   },
   "timeout_ms": 12000
  },
  {
   "action": "hotkey",
   "keys": [
    "cmd",
    "a"
   ],
   "timeout_ms": 6000
  },
  {
   "action": "click",
   "target": {
    "text": "Format",
    "scope": "chrome"
   },
   "expect": {
